<?xml version="1.0"?>
<robot name="quori" xmlns:xacro="http://ros.org/wiki/xacro">

        <ros2_control name="quori_hardware/QuoriHeadSystemHardware" type="system">
            <hardware>
                <plugin>quori_hardware/QuoriHeadSystemHardware</plugin>
                <param name="robot_ip_address">10.2.99.111</param>
                <param name="ethernet_interface">eth0</param>
            </hardware>
            <joint name="neck_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="acceleration"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <param name="initial_position">0.0</param>
                <param name="max_velocity">1.0</param>       
                <param name="max_torque">6.0</param>
                <param name="max_accel">1000.0</param>
                <param name="transmission_ratio">180.0</param>
            </joint>
            <joint name="pan_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="acceleration"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <param name="initial_position">0.0</param>
                <param name="max_velocity">200.0</param>
                <param name="max_torque">5.0</param>
                <param name="max_accel">500</param>
                <param name="transmission_ratio">1.0</param>
            </joint>
            <joint name="tilt_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="acceleration"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <param name="initial_position">0.0</param>
                <param name="max_velocity">200.0</param>
                <param name="max_torque">5.0</param>
                <param name="max_accel">500</param>
                <param name="transmission_ratio">1.0</param>
            </joint>
        </ros2_control>
        
</robot>
