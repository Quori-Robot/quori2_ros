<?xml version="1.0"?>
<robot name="quori" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="use_sim" default="false"/>
  <xacro:arg name="camera_type"   default="gemini335" />

  <xacro:include filename="$(find quori_description)/src/description/quori_properties.urdf"/>
  <xacro:include filename="$(find quori_description)/src/description/quori_util.urdf"/>
  <xacro:include filename="$(find quori_description)/src/description/quori_hardware.urdf"/>
  <xacro:include filename="$(find quori_description)/src/description/quori.gazebo"/>


  <!-- Robot Footprint -->
  <link name="base_footprint"/>

  <!-- Main reference point -->
  <link name="base_link"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 ${(wheel_radius)}" rpy="0 0 0"/>
  </joint>

  <link name="body_plate_link">
    <visual>
      <geometry>
        <cylinder radius="${base_plate_radius}" length="${base_plate_height}"/> 
      </geometry>
      <material name="PaperYellow"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="${base_plate_radius}" length="${base_plate_height}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia m="3" r="${base_plate_radius}" h="${base_plate_height}">
       <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </xacro:cylinder_inertia>
  </link>

  <joint name="body_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_plate_link"/>
    <origin xyz="0.0 0.0 ${base_plate_z_offset}" rpy="0 0 0"/>
  </joint>

  <!-- Robot Diff Base -->
  <link name="diff_base_link">
    <visual>
      <geometry>
        <cylinder radius="${diff_base_radius}" length="${diff_base_height}"/> 
      </geometry>
      <material name="PaperYellow"/>
=
    </visual>

    <collision>
      <geometry>
        <cylinder radius="${diff_base_radius}" length="${diff_base_height}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia m="3" r="${diff_base_radius}" h="${diff_base_height}">
       <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </xacro:cylinder_inertia>
  </link>


  <joint name="twist_joint" type="continuous">
    <parent link="base_link"/>
    <child link="diff_base_link"/>
    <axis xyz="0 0 -1"/>
    <dynamics friction="0.5" damping="0.1" />
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Robot body

  <link name="body_link">

    <origin xyz="0 0 0" rpy="0 0 0"/>
    <visual>
      <geometry>
        <box size="${body_depth} ${body_width} ${body_height}"/> 
      </geometry>
      <material name="BodyWhite">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="${body_depth} ${body_width} ${body_height}"/>  
      </geometry>
    </collision>
    <xacro:box_inertia m="1.0" w="${body_width}" h="${body_height}" d="${body_depth}"/> 
  </link>

  
  <joint name="body_joint" type="fixed">
    <parent link="spine_link"/>
    <child link="body_link"/>
    <origin xyz="0.0 0.0 ${(spine_height/2+base_height/2)}" rpy="0 0 0"/>
  </joint>

  -->

  <!-- Robot spine -->
  <link name="spine_link">

    <origin xyz="0 0 0" rpy="0 0 0"/>
    <visual>
      <geometry>
         <cylinder radius="${spine_radius}" length="${spine_height}"/> 
      </geometry>
      <material name="BodyWhite"/>

    </visual>

    <collision>
      <geometry>
        <cylinder radius="${spine_radius}" length="${spine_height}"/>  
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="3" r="${spine_radius}" h="${spine_height}">
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </xacro:cylinder_inertia>

  </link>

  <link name="twist_offset"/>

  <joint name="twist_offset_joint" type="continuous">
    <parent link="base_link"/>
    <child link="twist_offset"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/> 
    <axis xyz="0 0 1"/>
    <dynamics friction="0.00001" damping="0.000001" />
  </joint>

  <joint name="spine_joint" type="fixed">
    <parent link="base_link"/>
    <child link="twist_offset"/>
    <origin xyz="0.0 0.0 ${(spine_height/2+diff_base_height/2)}" rpy="0 0 0"/>
  </joint>

  <link name="collar_link" >
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <visual>
      <geometry>
         <cylinder radius="${collar_radius}" length="${collar_height}"/> 
      </geometry>
      <material name="BodyWhite"/>

    </visual>

    <collision>
      <geometry>
        <cylinder radius="${collar_radius}" length="${collar_height}"/>  
      </geometry>
    </collision>

    <xacro:cylinder_inertia m="0.1" r="${collar_radius}" h="${collar_height}">
       <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </xacro:cylinder_inertia>

  </link>

  <joint name="neck_joint" type="prismatic">
    <parent link="spine_link"/>
    <child link="collar_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-spine_height/4}" upper="${spine_height/4}" effort="1000" velocity="0.3" />
    <dynamics friction="0.1" damping="0.01" />
    <origin xyz="0.0 0.0 ${spine_height/4}" rpy="0 0 0"/>
  </joint>

  <link name="neck_link"> 

    <origin xyz="${neck_depth/2} 0.0 0.0" rpy="0 0 0"/>
    <visual>
      <origin xyz="${neck_depth/2} 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="${neck_depth} ${neck_width} ${neck_height}"/> 
      </geometry>
      <material name="BodyWhite"/>

    </visual>

    <collision> 
      <origin xyz="${neck_depth/2} 0.0 0.0" rpy="0 0 0"/>
      <geometry>
       
        <box size="${neck_depth} ${neck_width} ${neck_height}"/>  
      </geometry>
    </collision>
    <xacro:box_inertia m="0.3" y="${neck_width}" z="${neck_height}" x="${neck_depth}"> 
        <origin xyz="${neck_depth/2} 0.0 0.0" rpy="0 0 0"/>
    </xacro:box_inertia>

  </link>

  <joint name="pan_joint" type="revolute">
    <parent link="collar_link"/>
    <child link="neck_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi/2}" upper="${pi/2}"  effort="1000" velocity="400" />
    <dynamics friction="0.1" damping="0.01" />
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>


  <!-- Robot Head -->
  <link name="head_link">

    <origin xyz="0 0 0" rpy="0 0 0"/>
    <visual>
      <geometry>
        <box size="${head_depth} ${head_width} ${head_height}"/> 
      </geometry>
      <material name="HeadBlack"/>

    </visual>

    <collision>
      <geometry>
        <box size="${head_depth} ${head_width} ${head_height}"/>  
      </geometry>
    </collision>
    <xacro:box_inertia m="1.0" y="${head_width}" z="${head_height}" x="${head_depth}"> 
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </xacro:box_inertia>

  </link>

  <joint name="tilt_joint" type="revolute">
    <parent link="neck_link"/>
    <child link="head_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/4}" upper="${pi/4}"  effort="10000" velocity="400"/>
    <dynamics friction="0.01" damping="0.001" />
    <origin xyz="${neck_depth} 0.0 0.0" rpy="0 0 0"/>
  </joint>
 
  <!-- IMUs -->
  <xacro:imu name="base_mtr" parent="diff_base_link">
      <origin xyz="${imu_base_mtr_x} ${imu_base_mtr_y} ${imu_base_mtr_z}" rpy="${imu_base_mtr_roll} ${imu_base_mtr_pitch} ${imu_base_mtr_yaw}"/>
  </xacro:imu>

  <xacro:imu name="main" parent="body_plate_link">
        <origin xyz="${imu_main_x} ${imu_main_y} ${imu_main_z}"  rpy="${imu_main_roll} ${imu_main_pitch} ${imu_main_yaw}"/>
  </xacro:imu>

  <xacro:imu name="head" parent="head_link">
        <origin xyz="${imu_head_x} ${imu_head_y} ${imu_head_z}" rpy="${imu_head_roll} ${imu_head_pitch} ${imu_head_yaw}"/>
  </xacro:imu>

  <!-- Wheels-->

  <xacro:wheel prefix="left_wheel" x_reflect="1" y_reflect="1" />

  <xacro:wheel prefix="right_wheel" x_reflect="1" y_reflect="-1" />

    <!-- Caster Wheel -->
  <link name="left_caster">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="Black"/>

    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>

    <xacro:sphere_inertia m="0.1" r="${caster_radius}"/>
  </link>

      <!-- Caster Wheel -->
  <link name="right_caster">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="Black"/>

    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>

    <xacro:sphere_inertia m="0.1" r="${caster_radius}"/>
  </link>

  <joint name="left_caster_joint" type="fixed">
    <parent link="diff_base_link"/>
    <child link="left_caster"/>
    <origin xyz="${caster_xoff} ${caster_yoff} ${-(wheel_radius-caster_radius)+0.001}" rpy="0 0 0"/>
  </joint>
  
  <joint name="right_caster_joint" type="fixed">
    <parent link="diff_base_link"/>
    <child link="right_caster"/>
    <origin xyz="${caster_xoff} ${-caster_yoff}  ${-(wheel_radius-caster_radius)+0.001}" rpy="0 0 0"/>
  </joint>



  <!-- Lidar 1 -->
  <link name="lidar1_base_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <visual>
      <origin xyz="0 0 0.0" rpy="${pi/2} 0 ${pi}"/>
      <geometry>
          <mesh filename="package://quori_description/meshes/rplidar.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Blue"/>

    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.059 0.0600 0.0758"/>
      </geometry>
    </collision>

    <xacro:box_inertia m="0.15" y="0.060" z="0.0758" x="0.056" >
       <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>

  <joint name="lidar1_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar1_base_link"/>
    <origin xyz="${lidar_xoff} 0.0 ${lidar_zoff}" rpy="0 0 0"/>
    
  </joint>

  <link name="lidar1_link"/>

  <joint name="lidar1_joint" type="fixed">
    <parent link="lidar1_base_link"/>
    <child link="lidar1_link"/>
    <origin xyz="0.0 0.0 0.031" rpy="0 0 ${lidar1_ang_offset}"/>
  </joint>

    <!-- Lidar 2 -->
  <link name="lidar2_base_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <visual>
      <origin xyz="0 0 0.0" rpy="${pi/2} 0 ${pi}"/>
      <geometry>
          <mesh filename="package://quori_description/meshes/rplidar.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Blue"/>

    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.059 0.0600 0.0758"/>
      </geometry>
    </collision>

    <xacro:box_inertia m="0.15" y="0.060" z="0.0758" x="0.06" >
       <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>

  <joint name="lidar2_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar2_base_link"/>
    <origin xyz="${-lidar_xoff} 0.0 ${lidar_zoff}" rpy="0 0 0"/>
  </joint>

  <link name="lidar2_link"/>
  <joint name="lidar2_joint" type="fixed">
    <parent link="lidar2_base_link"/>
    <child link="lidar2_link"/>
    <origin xyz="0.0 0.0 0.031" rpy="0 0 ${lidar2_ang_offset}"/>
  </joint>

  <!-- Depth Camera-->

  <xacro:property name="camera_type" value="$(arg camera_type)"/>

  <link name="camera_mount_link" />

  <joint name="camera_mount_joint" type="fixed">
    <parent link="head_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="${cam_top_xoff} 0 ${cam_top_zoff}" rpy="0 ${-cam_top_tilt} 0"/>
  </joint>

  <xacro:if  value="${camera_type == 'gemini335'}">
       <xacro:include filename="$(find orbbec_description)/urdf/_gemini_335_336.urdf.xacro"/>
  </xacro:if>

  <joint name="camera_link_mount_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <link name="respeaker_link"/>
  <joint name="respeaker_joint" type="fixed">
    <parent link="spine_link"/>
    <child link="respeaker_link"/>
    <origin xyz="${respeaker_x} ${respeaker_y} ${respeaker_z}" rpy="0 0 ${respeaker_yaw}"/>
  </joint>

  <xacro:macro name="respeaker_mic" params="index pos*">
    <link name="respeaker_mic_${index}_link"/>
    <joint name="respeaker_mic_${index}_joint" type="fixed">
      <parent link="respeaker_link"/>
      <child link="respeaker_mic_${index}_link"/>
      <xacro:insert_block name="pos"/>
    </joint>
  </xacro:macro>

  <xacro:respeaker_mic index="0" >
     <origin xyz="0.02425 0.02425 0.0012" rpy="0 0 ${pi/4}"/>
  </xacro:respeaker_mic>

  <xacro:respeaker_mic index="1" >
     <origin xyz="-0.02425 0.02425 0.0012" rpy="0 0 ${pi/2}"/>
  </xacro:respeaker_mic>

  <xacro:respeaker_mic index="2" >
     <origin xyz="-0.02425 -0.02425 0.0012" rpy="0 0 ${3*pi/4}"/>
  </xacro:respeaker_mic>

  <xacro:respeaker_mic index="3" >
     <origin xyz="0.02425 -0.02425 0.0012" rpy="0 0 ${-pi/4}"/>
  </xacro:respeaker_mic>

</robot>
