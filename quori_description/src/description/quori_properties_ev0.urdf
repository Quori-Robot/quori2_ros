<?xml version="1.0"?>
<robot name="quori" xmlns:xacro="http://ros.org/wiki/xacro">


  <!-- Define robot constants -->
  <!-- xacro:property name="pi" value="3.141592654"/ -->

  <!-- all values in meters -->
  <xacro:property name="base_radius" value="0.140"/>
  <xacro:property name="base_height" value="0.080"/>


  <xacro:property name="body_width" value="0.050"/>
  <xacro:property name="body_depth" value="0.050"/>
  <xacro:property name="body_height" value="0.5"/>

  <xacro:property name="wheel_radius" value="0.065"/>
  <xacro:property name="wheel_width" value="0.03"/>

  <xacro:property name="wheel_ygap" value="0.0"/>

  <xacro:property name="wheel_yoff" value="0.16"/>

  <xacro:property name="wheel_xoff" value="0.0"/>

  <xacro:property name="caster_radius" value="0.04"/>
  <xacro:property name="caster_xoff"   value="0.13"/>

  <xacro:property name="lidar_xoff" value="0.09"/>
  <xacro:property name="lidar_zoff" value="0.065"/> <!-- base link to bottom of lidar -->

 
  <xacro:property name="cam_top_xoff" value="0.05"/>
  <xacro:property name="cam_top_zoff" value="0.5"/>
  <xacro:property name="cam_top_tilt" value="0.0"/>

  <xacro:property name="cam_rgb_xoff" value="0.03"/>
  <xacro:property name="cam_rgb_zoff" value="1.02"/>
  <xacro:property name="cam_rgb_tilt" value="0.0"/>


</robot>
