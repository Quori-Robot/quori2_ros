<?xml version="1.0"?>
<robot name="quori" xmlns:xacro="http://ros.org/wiki/xacro">


  <!-- Define robot constants -->

  <!-- all values in meters -->
  <xacro:property name="base_plate_radius" value="0.140"/>
  <xacro:property name="base_plate_height" value="0.010"/>
  <xacro:property name="base_plate_z_offset" value="0.2"/> <!-- above base link -->
  
  <xacro:property name="mesh_z_offset" value="-0.046"/>     <!-- correct DAE mesh origins -->
  <xacro:property name="mesh_yaw_offset" value="${pi/2}"/> <!-- correct DAE mesh origins -->
  

  <xacro:property name="body_center_radius" value="0.03"/> 

  <xacro:property name="lidar_plate_radius" value="0.130"/>
  <xacro:property name="lidar_plate_height" value="0.007"/>
  <xacro:property name="lidar_plate_z_offset" value="${base_plate_z_offset-0.10205}"/>

  <xacro:property name="diff_base_radius" value="0.140"/>
  <xacro:property name="diff_base_height" value="0.06"/>

  <xacro:property name="spine_radius" value="0.035"/>
  <xacro:property name="spine_height" value="1.154"/>
  <xacro:property name="spine_x_offset" value="0.07"/>

  <xacro:property name="neck_travel" value="0.25"/>
  <xacro:property name="head_tilt_x_off" value="0.15"/>

  <xacro:property name="collar_radius" value="0.05"/>
  <xacro:property name="collar_height" value="0.04"/>

  <xacro:property name="neck_width" value="0.120"/>
  <xacro:property name="neck_depth"  value="0.06"/>
  <xacro:property name="neck_height" value="0.04"/>

  <xacro:property name="head_width" value="0.200"/>
  <xacro:property name="head_depth" value="0.030"/>
  <xacro:property name="head_height" value="0.080"/>

  <xacro:property name="wheel_radius" value="0.065"/>
  <xacro:property name="wheel_width" value="0.03"/>

  <xacro:property name="wheel_ygap" value="0.0"/>
  <xacro:property name="wheel_yoff" value="0.1615"/>
  <xacro:property name="wheel_xoff" value="-0.117935"/>

  <xacro:property name="caster_radius" value="0.0381"/>
  <xacro:property name="caster_xoff"   value="0.16746"/>
  <xacro:property name="caster_yoff"   value="0.115"/>

  <xacro:property name="lidar_xoff" value="0.0775"/>
  <xacro:property name="lidar_zoff" value="${lidar_plate_height/2}"/> 
  <xacro:property name="lidar1_ang_offset" value="${-pi/2}"/>
  <xacro:property name="lidar2_ang_offset" value="${-pi/2}"/>

 
  <xacro:property name="cam_top_xoff" value="0.088"/>
  <xacro:property name="cam_top_zoff" value="${head_height/2+0.01}"/>
  <xacro:property name="cam_top_tilt" value="0.0"/>

  <!-- xacro:property name="cam_rgb_xoff" value="0.03"/>
  <xacro:property name="cam_rgb_zoff" value="1.02"/>
  <xacro:property name="cam_rgb_tilt" value="0.0"/ -->

  <xacro:property name="imu_base_mtr_x" value="-0.06"/>
  <xacro:property name="imu_base_mtr_y" value="0.06"/>
  <xacro:property name="imu_base_mtr_z" value="${diff_base_height/2+0.01}"/>
  <xacro:property name="imu_base_mtr_roll" value="0.0"/>
  <xacro:property name="imu_base_mtr_pitch" value="0.0"/>
  <xacro:property name="imu_base_mtr_yaw" value="0.0"/>

  <xacro:property name="imu_head_x" value="${0.08}"/>
  <xacro:property name="imu_head_y" value="0.0"/>
  <xacro:property name="imu_head_z" value="0.045"/>
  <xacro:property name="imu_head_roll" value="0.0"/>
  <xacro:property name="imu_head_pitch" value="${pi/2}"/>
  <xacro:property name="imu_head_yaw" value="0.0"/>

  <xacro:property name="imu_main_x" value="-0.06"/>
  <xacro:property name="imu_main_y" value="-0.06"/>
  <xacro:property name="imu_main_z" value="${base_plate_height/2+0.01}"/>
  <xacro:property name="imu_main_roll" value="0.0"/>
  <xacro:property name="imu_main_pitch" value="0.0"/>
  <xacro:property name="imu_main_yaw" value="0.0"/>


  <xacro:property name="respeaker_x" value="0.0"/>
  <xacro:property name="respeaker_y" value="0.0"/>
  <xacro:property name="respeaker_z" value="${spine_height/2}"/>
  <xacro:property name="respeaker_yaw" value="${pi/4}"/>

  <xacro:property name="head_speaker_x" value="0.08"/>
  <xacro:property name="head_speaker_y" value="0.06"/>
  <xacro:property name="head_speaker_z" value="0.04"/>
  <xacro:property name="head_speaker_roll" value="0.0"/>
  <xacro:property name="head_speaker_pitch" value="${pi/2}"/>
  <xacro:property name="head_speaker_yaw" value="${pi}"/>

  <xacro:property name="base_speaker_x" value="0.05"/>
  <xacro:property name="base_speaker_y" value="0.06"/>
  <xacro:property name="base_speaker_z" value="${base_plate_height/2+0.03}"/>
  <xacro:property name="base_speaker_roll" value="0.0"/>
  <xacro:property name="base_speaker_pitch" value="0.0"/>
  <xacro:property name="base_speaker_yaw" value="0.0"/>

</robot>
