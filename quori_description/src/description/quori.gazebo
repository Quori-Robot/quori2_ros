<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
 
 
    <!-- ground locked reference frame -->
    <gazebo reference="base_footprint"></gazebo>

    <!-- virtual reference frame -->
    <gazebo reference="base_link"></gazebo>

    <!-- differential drive base -->
    <gazebo reference="diff_base_link">
        <material>Gazebo/Gray</material>
    </gazebo>

    <!-- join diff base to body -->
    <gazebo reference="twist_joint"></gazebo>

    <gazebo reference="twist_offset_link" />
    <gazebo reference="twist_offset_joint" />

    <gazebo reference="spine_link">
        <material>Gazebo/Gray</material>
    </gazebo>

    <gazebo reference="collar_link"></gazebo>
    <gazebo reference="spine_joint"></gazebo>

    <gazebo reference="neck_link">
        <material>Gazebo/Gray</material>
    </gazebo>

    <gazebo reference="head_link">
        <material>Gazebo/Gray</material>
    </gazebo>

    <gazebo reference="neck_joint"></gazebo>
    <gazebo reference="pan_joint"></gazebo>
    <gazebo reference="tilt_joint"></gazebo>
    
    <gazebo reference="left_wheel_link">
        <mu1>100.0</mu1>
        <mu2>10.0</mu2>
        <kp>1000000.0</kp>
        <kd>0.1</kd>
        <max_vel>100</max_vel>
        <min_depth>0.001</min_depth>
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="right_wheel_link">
        <mu1>100.0</mu1>
        <mu2>10.0</mu2>
        <kp>1000000.0</kp>
        <kd>0.1</kd>
        <max_vel>100</max_vel>
        <min_depth>0.001</min_depth>
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="left_wheel_mount_link"></gazebo>
    <gazebo reference="right_wheel_mount_link"></gazebo>


    <gazebo reference="left_wheel_joint">

    </gazebo>

    <gazebo reference="right_wheel_joint">

    </gazebo>

    <gazebo reference="left_caster">
        <mu1>0.00000</mu1>
        <mu2>0.00000</mu2>
        <!-- kp>100000.0</kp>
        <kd>1.0</kd  -->
        <max_vel>100</max_vel>
        <min_depth>0.000</min_depth>
        <material>Gazebo/Black</material>
    </gazebo>
    

    <gazebo reference="right_caster">
        <mu1>0.00000</mu1>
        <mu2>0.00000</mu2>
        <!-- kp>100000.0</kp>
        <kd>1.0</kd  -->
        <max_vel>100</max_vel>
        <min_depth>0.000</min_depth>
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="left_caster_joint"></gazebo>
    <gazebo reference="right_caster_joint"></gazebo>

    
    <gazebo reference="lidar1_link">

        <sensor name="lidar1" type="gpu_lidar">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <pose>0.0 0.0 0.0 0 0 0</pose>
            <update_rate>10</update_rate>
            <topic>lidar1/scan</topic>
            <gz_frame_id>lidar1_link</gz_frame_id>
            <lidar>

                <scan>
                    <horizontal>
                        <samples>800</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-0.78539816339744830961566084581988</min_angle>
                        <max_angle>3.9269908169872415480783042290994</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.2</min>
                    <max>12.0</max>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.02</stddev>
                </noise>

            </lidar>
        </sensor>
   
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="lidar2_link">

        <sensor name="lidar2" type="gpu_lidar">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <pose>0.0 0.0 0.0 0 0 0</pose>
            <update_rate>5</update_rate>
            <topic>lidar2/scan</topic>
            <gz_frame_id>lidar2_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>800</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-3.9269908169872415480783042290994</min_angle>
                        <max_angle>0.78539816339744830961566084581988</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.2</min>
                    <max>12.0</max>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.02</stddev>
                </noise>

            </lidar>
        </sensor>

      
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="lidar1_base_joint">
    </gazebo>

    <gazebo reference="lidar1_joint">
    </gazebo>

    <gazebo reference="lidar1_base_link">
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="lidar2_base_joint">
    </gazebo>

    <gazebo reference="lidar2_joint">
    </gazebo>

    <gazebo reference="lidar2_base_link">
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="head_imu_joint"></gazebo>
    <gazebo reference="main_imu_joint"></gazebo>
    <gazebo reference="base_mtr_imu_joint"></gazebo>

    <gazebo reference="imu_head_link">
        <material>Gazebo/Yellow</material>

        <sensor name="imu_head" type="imu">
            <always_on>true</always_on>
            <!-- Publish at 30 hz -->
            <update_rate>100</update_rate>
            <topic>imu_head_raw</topic>
            <gz_frame_id>imu_head_link</gz_frame_id>
            <!-- plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
            <ros>
                <!- - Will publish to /imu/data - ->       
                <remapping>~/out:=/imu_head_raw</remapping>
            </ros>
            <!- - frame_name ommited, will be "my_link" - ->
            </plugin -->
        </sensor>
    </gazebo>

    <gazebo reference="imu_base_mtr_link">
        <material>Gazebo/Yellow</material>

        <sensor name="imu_base_mtr" type="imu">
            <always_on>true</always_on>
            <!-- Publish at 30 hz -->
            <update_rate>100</update_rate>
            <topic>imu_base_mtr_raw</topic>
            <gz_frame_id>imu_base_mtr_link</gz_frame_id>
            <!-- plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
            <ros>
                <!- - Will publish to /imu/data - ->
                <remapping>~/out:=/imu_base_mtr_raw</remapping>
            </ros>
            <!- - frame_name ommited, will be "my_link" - ->
            </plugin -->
        </sensor>
    </gazebo>

    <gazebo reference="imu_main_link">
        <material>Gazebo/Yellow</material>

        <sensor name="imu_main" type="imu">
            <always_on>true</always_on>
            <!-- Publish at 30 hz -->
            <update_rate>100</update_rate>
            <topic>imu_main_raw</topic>
            <gz_frame_id>imu_main_link</gz_frame_id>
            <!-- plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
            <ros>
                <!- - Will publish to /imu/data - ->
                <remapping>~/out:=/imu_main_raw</remapping>
            </ros>
            <!- - frame_name ommited, will be "my_link" - ->
            </plugin -->
        </sensor>
    </gazebo>



    <gazebo>

        <!-- JOINT CONTROLL PLUGINS -->
        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
            <joint_name>twist_joint</joint_name>
            <initial_velocity>0.0</initial_velocity>
            <topic>twist_joint_vel_cmd</topic>
        </plugin>

        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
            <joint_name>left_wheel_joint</joint_name>
            <initial_velocity>0.0</initial_velocity>
            <topic>left_wheel_joint_vel_cmd</topic>
        </plugin>

        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
            <joint_name>right_wheel_joint</joint_name>
            <initial_velocity>0.0</initial_velocity>
            <topic>right_wheel_joint_vel_cmd</topic>
        </plugin>

        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>neck_joint</joint_name>
            <initial_position>0.0</initial_position>
            <topic>neck_joint_pos</topic>
            <p_gain>500</p_gain>
            <i_gain>200</i_gain>
            <d_gain>50</d_gain>

        </plugin>

        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>pan_joint</joint_name>
            <initial_position>0.0</initial_position>
            <topic>pan_joint_pos</topic>
            <p_gain>5</p_gain>
            <i_gain>10</i_gain>
            <d_gain>1</d_gain>
        </plugin>

        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>tilt_joint</joint_name>
            <initial_position>0.0</initial_position>
            <topic>tilt_joint_pos</topic>
            <p_gain>5</p_gain>
            <i_gain>1</i_gain>
            <d_gain>1</d_gain>
        </plugin>


        <!-- plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
  
            <!- - wheels - ->
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <!- - kinematics - ->
            <wheel_separation>${2*wheel_yoff}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius> 

            <!- - limits - ->
            <max_linear_acceleration>200.0</max_linear_acceleration> 

            <topic>cmd_vel</topic> 

            <odom_topic>odom_raw</odom_topic> 
            <frame_id>odom</frame_id> 
            <child_frame_id>base_footprint</child_frame_id> 
            <odom_publisher_frequency>30</odom_publisher_frequency>

            <tf_topic>/tf</tf_topic>

        </plugin -->

        <!-- publish wheel and twsit joints -->
        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>quori_joint_states</topic> 
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
            <joint_name>twist_joint</joint_name>
            <!-- joint_name>twist_offset_joint</joint_name -->
        </plugin>

        <!-- publish neck,pan,tilt joints -->
        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>neck_joint_states</topic> 
            <joint_name>neck_joint</joint_name>
            <joint_name>tilt_joint</joint_name>
            <joint_name>pan_joint</joint_name>
        </plugin>
    </gazebo>


    <!-- RGB cam -->

    <gazebo reference="camera_mount_link" />

    <gazebo reference="camera_link">
        <material>Gazebo/Black</material>
    </gazebo>

  
    <gazebo reference="camera_bottom_screw_frame"/>
    <gazebo reference="camera_bottom_screw_frame_joint"/>


    <gazebo reference="camera_color_optical_frame" />

    <gazebo reference="camera_depth_optical_frame" />
    <gazebo reference="camera_depth_frame" />

    <gazebo reference="camera_infra_1_optical_frame" />
    <gazebo reference="camera_infra_1_frame" />

    <gazebo reference="camera_infra2_optical_frame" />
    <gazebo reference="camera_infra2_frame" />


    <gazebo reference="camera_mount_joint" />
    <gazebo reference="camera_link_mount_joint" />


    <gazebo reference="camera_color_joint" />
    <gazebo reference="camera_color_optical_joint" />

    <gazebo reference="camera_depth_joint" />
    <gazebo reference="camera_depth_optical_joint" />

    <gazebo reference="camera_infra_1_joint" />
    <gazebo reference="camera_infra_1_optical_joint" />

    <gazebo reference="camera_infra2_joint" />
    <gazebo reference="camera_infra2_optical_joint" />

    <!-- generate the RGBD camera image -->
    <gazebo reference="camera_depth_frame">
        <sensor name="depth_camera" type="depth_camera">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <topic>camera/depth_image_raw</topic>
            <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
            <update_rate>15</update_rate>
            <camera name="depth_camera">
                <horizontal_fov>1.085595</horizontal_fov>
                <image>
                    <width>1280</width>
                    <height>960</height>
                    <format>R_FLOAT32</format>
                    <!-- format>BGR8</format -->
                </image>
                <clip>
                    <near>0.03</near>
                    <far>1000</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <!-- Noise is sampled independently per pixel on each frame.
                        That pixel's noise value is added to each of its color
                        channels, which at that point lie in the range [0,1]. -->
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>

        </sensor>
    </gazebo>
    <gazebo reference="camera_color_frame">
        <sensor name="color_camera" type="camera">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <topic>camera/image_raw</topic>
            <gz_frame_id>camera_color_optical_frame</gz_frame_id>
            <update_rate>15</update_rate>
            <camera name="color_camera">
                <horizontal_fov>1.085595</horizontal_fov>
                <image>
                    <width>1280</width>
                    <height>960</height>
                   
                    <!-- format>BGR8</format -->
                </image>
                <clip>
                    <near>0.03</near>
                    <far>1000</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <!-- Noise is sampled independently per pixel on each frame.
                        That pixel's noise value is added to each of its color
                        channels, which at that point lie in the range [0,1]. -->
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>

        </sensor>
    </gazebo>

    <gazebo reference="respeaker_link" />
    <gazebo reference="respeaker_joint" />

    <gazebo reference="respeaker_mic_0_link" />
    <gazebo reference="respeaker_mic_0_joint" />

    <gazebo reference="respeaker_mic_1_link" />
    <gazebo reference="respeaker_mic_1_joint" />

    <gazebo reference="respeaker_mic_2_link" />
    <gazebo reference="respeaker_mic_2_joint" />

    <gazebo reference="respeaker_mic_3_link" />
    <gazebo reference="respeaker_mic_3_joint" />

    <gazebo reference="head_speaker_link" />
    <gazebo reference="head_speaker_joint" />

    <gazebo reference="base_speaker_link" />
    <gazebo reference="base_speaker_joint" />

</robot>
