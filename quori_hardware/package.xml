<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quori_hardware</name>
  <version>0.0.0</version>
  <description>Package for ros2_controll hardware components for quri neck and head joints</description>
  <maintainer email="quori@todo.todo">quori</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>quori2_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>quori_msgs</depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_add_gtest</test_depend>
  <test_depend>hardware_interface</test_depend>
  <test_depend>rclcpp_lifecycle</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
